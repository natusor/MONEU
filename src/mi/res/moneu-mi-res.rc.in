#include <winver.h>

IDI_ICON1 ICON "@MI_ICON@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "CompanyName",      "MONEU"
            VALUE "FileDescription",  "MONEU Interface (MI)"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "moneu-mi"
            VALUE "LegalCopyright",   "Copyright (c) 2025-2026 natusor (MONEU). Distributed under the MIT software license."
            VALUE "OriginalFilename", "moneu-mi.exe"
            VALUE "ProductName",      "MONEU Interface (MI)"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1252
    END
END
